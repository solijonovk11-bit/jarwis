# JARVIS AI Backend Sozlamalari
HOST=127.0.0.1
PORT=8000
ENVIRONMENT=development

# AI Provayderi: "groq", "openai", "openrouter", "gemini", yoki "ollama"
AI_PROVIDER=groq

# API Kalitlari (Ixtiyoriy: agar bo'sh qoldirilsa, JARVIS lokal yordamchi rejimida ishlaydi)
GROQ_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=
GEMINI_API_KEY=

AI_MODEL=llama-3.3-70b-versatile
OLLAMA_BASE_URL=http://localhost:11434

ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

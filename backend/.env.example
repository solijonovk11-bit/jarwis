# JARVIS AI Backend Sozlamalari
HOST=127.0.0.1
PORT=8000
ENVIRONMENT=development

# AI Provayderi: "groq", "openai", "openrouter", "gemini", yoki "ollama"
AI_PROVIDER=groq

# API Kalitlari (O'zingizga mos birortasini kiriting)
GROQ_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=
GEMINI_API_KEY=

# Model nomlari
# Groq: llama-3.3-70b-versatile, llama3-8b-8192
# OpenAI: gpt-4o-mini, gpt-4o
# Gemini: gemini-1.5-flash
# Ollama: llama3:latest
AI_MODEL=llama-3.3-70b-versatile

# Ollama Host (agar lokal Ollama ishlatilsa)
OLLAMA_BASE_URL=http://localhost:11434

# CORS ruxsat berilgan domenlar
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
